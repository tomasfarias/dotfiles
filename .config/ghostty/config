# Looks
background              = 001e26
foreground              = 9bc1c2
theme                   = Solarized Dark Higher Contrast
window-decoration       = false
mouse-hide-while-typing = true
gtk-tabs-location       = top
gtk-custom-css          = ./ghostty.css

# Font
font-size               = 14
font-family             = Maple Mono

# Keybinds
keybind = clear
keybind = ctrl+x>ctrl+q=quit
keybind = performable:ctrl+shift+c=copy_to_clipboard
keybind = performable:ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+enter=reload_config

## Splits
keybind = ctrl+x>3=new_split:right
keybind = ctrl+x>2=new_split:down
keybind = performable:ctrl+x>o=goto_split:next
keybind = ctrl+x>0=close_surface

## Tabs
# keybind = ctrl+x>t>2=new_tab
# keybind = performable:ctrl+x>t>0=close_tab
# keybind = performable:ctrl+TAB=next_tab
# keybind = performable:ctrl+shift+TAB=previous_tab

## Font size key table
### Based on emacs keybinds to manage font size
keybind = font-size/==increase_font_size:1
keybind = font-size/-=decrease_font_size:1
keybind = font-size/0=reset_font_size
keybind = font-size/catch_all=deactivate_key_table

keybind = ctrl+x>ctrl+==increase_font_size:1
keybind = chain=activate_key_table:font-size
keybind = ctrl+x>ctrl+-=decrease_font_size:1
keybind = chain=activate_key_table:font-size
keybind = ctrl+x>ctrl+0=reset_font_size
keybind = chain=activate_key_table:font-size

## Zellij
keybind = unconsumed:super+z=activate_key_table:zellij
keybind = zellij/unconsumed:ctrl+q=deactivate_key_table
keybind = zellij/catch_all=unbind

## Emacs
### Keep in sync with fish keybind to run emacs
keybind = unconsumed:super+e=activate_key_table:emacs
### Do not consume input on leaving to exit emacs
keybind = emacs/unconsumed:ctrl+x>ctrl+c=deactivate_key_table
### Unbind conflicting keys
keybind = emacs/catch_all=unbind



# Copy Ghostty's terminfo when SSH'ing to a new server, fallback to setting xterm-256color if copy fails.
shell-integration-features = ssh-terminfo,ssh-env
